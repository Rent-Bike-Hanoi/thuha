# Seeds đợt 2, 12/10/2026: bổ sung bằng chứng đã đối chiếu cho 10 hàng RESEARCH (discover --update).
{"hub": "luat-giao-thong", "subtopic": "muc-phat", "title": "Lỗi biển số xe máy phạt bao nhiêu? Không biển, che biển, biển mờ, biển giả", "primary_keyword": "xe máy không có biển số phạt bao nhiêu", "secondary_keywords": ["che biển số xe máy phạt bao nhiêu", "biển số xe máy bị mờ có bị phạt không"], "user_problem": "Xe mới mua chưa có biển, mất biển, biển bẩn/che một phần hoặc biển giả; muốn biết mức phạt từng trường hợp và trách nhiệm của chủ xe.", "information_gain": "Bài /luat-giao-thong/quen-bang-lai-giay-to-xe-may-co-bi-phat-khong/ chỉ có một bảng ngắn về Điều 14 (gương, còi, đèn); bài /xe-dien/xe-may-dien-co-can-dang-ky-bien-so-khong/ nói xe nào phải đăng ký. Bài này tra cứu riêng nhóm lỗi biển số theo Điều 14 Nghị định 168: không gắn biển, biển không đúng đăng ký hoặc không do cơ quan có thẩm quyền cấp (4–6 triệu, tịch thu biển số, trừ 6 điểm); biển sai vị trí, bị che lấp, bẻ cong, dán đè chữ số (4–6 triệu, trừ 6 điểm); không có hoặc hết hạn chứng nhận đăng ký xe (2–3 triệu, trừ 2 điểm); trách nhiệm chủ xe đưa xe không biển ra đường (điểm h khoản 8 Điều 32: 4–6 triệu với cá nhân) và không làm thủ tục cấp biển khi đổi chủ (điểm a khoản 3 Điều 32: 800.000–1.000.000đ).", "evidence": [{"type": "law", "source": "https://xaydungchinhsach.chinhphu.vn/toan-van-nghi-dinh-168-2024-nd-cp-quy-dinh-xu-phat-vi-pham-hanh-chinh-ve-trat-tu-atgt-duong-bo-119241231164556785.htm", "quote": "3. Phạt tiền từ 4.000.000 đồng đến 6.000.000 đồng đối với một trong các hành vi vi phạm sau đây: a) Điều khiển xe không gắn biển số (đối với loại xe có quy định phải gắn biển số); gắn biển số không đúng với chứng nhận đăng ký xe hoặc gắn biển số không do cơ quan có thẩm quyền cấp; b) Điều khiển xe gắn biển số không đúng vị trí, không đúng quy cách theo quy định; gắn biển số không rõ chữ, số hoặc sử dụng chất liệu khác sơn, dán lên chữ, số của biển số xe; gắn biển số bị bẻ cong, che lấp, làm thay đổi chữ, số, màu sắc (của chữ, số, nền biển số xe), hình dạng, kích thước của biển số xe. (Điều 14 Nghị định 168)", "verbatim": true, "checked": "2026-10-12"}, {"type": "law", "source": "https://xaydungchinhsach.chinhphu.vn/toan-van-nghi-dinh-168-2024-nd-cp-quy-dinh-xu-phat-vi-pham-hanh-chinh-ve-trat-tu-atgt-duong-bo-119241231164556785.htm", "quote": "Điều 14 khoản 5 điểm a: thực hiện hành vi quy định tại điểm a khoản 3 Điều này bị tịch thu biển số xe; khoản 8: điểm a, b, c khoản 2 bị trừ 02 điểm; khoản 3 bị trừ 06 điểm giấy phép lái xe", "verbatim": false, "checked": "2026-10-12"}, {"type": "law", "source": "https://xaydungchinhsach.chinhphu.vn/toan-van-nghi-dinh-168-2024-nd-cp-quy-dinh-xu-phat-vi-pham-hanh-chinh-ve-trat-tu-atgt-duong-bo-119241231164556785.htm", "quote": "Điều 14 khoản 2 điểm a: điều khiển xe không có chứng nhận đăng ký xe ... hoặc sử dụng chứng nhận đăng ký xe đã hết hạn sử dụng, hết hiệu lực: 2.000.000–3.000.000 đồng", "verbatim": false, "checked": "2026-10-12"}, {"type": "law", "source": "https://xaydungchinhsach.chinhphu.vn/toan-van-nghi-dinh-168-2024-nd-cp-quy-dinh-xu-phat-vi-pham-hanh-chinh-ve-trat-tu-atgt-duong-bo-119241231164556785.htm", "quote": "Điều 32 khoản 8 (4.000.000–6.000.000 đồng với cá nhân, 8.000.000–12.000.000 đồng với tổ chức là chủ xe mô tô, xe gắn máy) điểm h: Đưa phương tiện không gắn biển số (đối với loại xe có quy định phải gắn biển số) tham gia giao thông; đưa phương tiện gắn biển số không đúng với chứng nhận đăng ký xe hoặc gắn biển số không do cơ quan có thẩm quyền cấp tham gia giao thông.", "verbatim": true, "checked": "2026-10-12"}, {"type": "law", "source": "https://xaydungchinhsach.chinhphu.vn/toan-van-nghi-dinh-168-2024-nd-cp-quy-dinh-xu-phat-vi-pham-hanh-chinh-ve-trat-tu-atgt-duong-bo-119241231164556785.htm", "quote": "Điều 32 khoản 3 (800.000–1.000.000 đồng với cá nhân) điểm a: Không làm thủ tục cấp chứng nhận đăng ký xe, biển số xe trong trường hợp thay đổi chủ xe theo quy định; điểm b: Không làm thủ tục đổi chứng nhận đăng ký xe, biển số xe theo quy định.", "verbatim": true, "checked": "2026-10-12"}], "content_type": "fine-lookup", "origin": "seed", "notes": "đã đối chiếu toàn văn Nghị định 168 ngày 12/10/2026 (Điều 14, Điều 32, Điều 47)", "suggested_internal_links": ["/luat-giao-thong/quen-bang-lai-giay-to-xe-may-co-bi-phat-khong/", "/xe-dien/xe-may-dien-co-can-dang-ky-bien-so-khong/", "/luat-giao-thong/tru-diem-bang-lai-xe-may/"], "outline": ["Câu trả lời ngắn", "Bảng mức phạt lỗi biển số theo Điều 14", "Biển mờ, biển bẩn, biển bị che một phần", "Xe mới mua chưa có biển, xe mua lại chưa sang tên", "Trách nhiệm của chủ xe theo Điều 32", "Tịch thu biển số và trừ điểm diễn ra thế nào", "Tra cứu và nộp phạt"]}
{"hub": "luat-giao-thong", "subtopic": "muc-phat", "title": "Giao xe máy cho người chưa đủ tuổi: chủ xe bị phạt bao nhiêu", "primary_keyword": "giao xe cho người chưa đủ tuổi phạt", "secondary_keywords": ["cho con mượn xe máy bị phạt bao nhiêu", "chủ xe giao xe cho người không có bằng lái"], "user_problem": "Phụ huynh cho con mượn xe, bạn bè cho mượn xe, cửa hàng giao xe; muốn biết chủ xe chịu trách nhiệm gì ngoài người lái.", "information_gain": "Bài /luat-giao-thong/bao-nhieu-tuoi-duoc-di-xe-may/ nêu mức phạt của chính người lái 14–18 tuổi. Bài này nói trách nhiệm của CHỦ XE: khoản 10 Điều 32 Nghị định 168 phạt 8–10 triệu đồng với cá nhân, 16–20 triệu đồng với tổ chức là chủ xe mô tô, xe gắn máy giao xe hoặc để cho người không đủ điều kiện (tuổi, sức khỏe, giấy phép còn điểm, còn hiệu lực theo khoản 1 Điều 56 Luật 36/2024) điều khiển, kể cả người đang bị tước bằng; cách lập biên bản khi chủ xe có mặt/vắng mặt (Điều 47); các tình huống phụ huynh, bạn bè, cửa hàng cho thuê và cách kiểm tra trước khi giao xe.", "evidence": [{"type": "law", "source": "https://xaydungchinhsach.chinhphu.vn/toan-van-nghi-dinh-168-2024-nd-cp-quy-dinh-xu-phat-vi-pham-hanh-chinh-ve-trat-tu-atgt-duong-bo-119241231164556785.htm", "quote": "10. Phạt tiền từ 8.000.000 đồng đến 10.000.000 đồng đối với cá nhân, từ 16.000.000 đồng đến 20.000.000 đồng đối với tổ chức là chủ xe mô tô, xe gắn máy và các loại xe tương tự xe mô tô, các loại xe tương tự xe gắn máy thực hiện hành vi vi phạm giao xe hoặc để cho người không đủ điều kiện theo quy định tại khoản 1 Điều 56 của Luật Trật tự, an toàn giao thông đường bộ điều khiển xe tham gia giao thông (bao gồm cả trường hợp người điều khiển phương tiện có giấy phép lái xe nhưng đang trong thời gian bị tước quyền sử dụng). (Điều 32 Nghị định 168)", "verbatim": true, "checked": "2026-10-12"}, {"type": "law", "source": "https://songoaivu.hatinh.gov.vn/imagess/seoworld/36-2024-qh15.pdf", "quote": "Điều 56 khoản 1: Người lái xe tham gia giao thông đường bộ phải đủ tuổi, sức khỏe theo quy định của pháp luật; có giấy phép lái xe đang còn điểm, còn hiệu lực phù hợp với loại xe đang điều khiển do cơ quan có thẩm quyền cấp, trừ người lái xe gắn máy quy định tại khoản 4 Điều này.", "verbatim": true, "checked": "2026-10-12"}, {"type": "law", "source": "https://songoaivu.hatinh.gov.vn/imagess/seoworld/36-2024-qh15.pdf", "quote": "Điều 59 khoản 1: a) Người đủ 16 tuổi trở lên được điều khiển xe gắn máy; b) Người đủ 18 tuổi trở lên được cấp giấy phép lái xe hạng A1, A, B1, B, C1", "verbatim": true, "checked": "2026-10-12"}, {"type": "law", "source": "https://xaydungchinhsach.chinhphu.vn/toan-van-nghi-dinh-168-2024-nd-cp-quy-dinh-xu-phat-vi-pham-hanh-chinh-ve-trat-tu-atgt-duong-bo-119241231164556785.htm", "quote": "Điều 18 khoản 1: Phạt cảnh cáo người từ đủ 14 tuổi đến dưới 16 tuổi điều khiển xe mô tô, xe gắn máy...; khoản 4 điểm a: Phạt tiền từ 400.000 đồng đến 600.000 đồng ... Người từ đủ 16 tuổi đến dưới 18 tuổi điều khiển xe mô tô có dung tích xi-lanh từ 50 cm3 trở lên hoặc có công suất động cơ điện từ 04 kW trở lên", "verbatim": true, "checked": "2026-10-12"}, {"type": "law", "source": "https://xaydungchinhsach.chinhphu.vn/toan-van-nghi-dinh-168-2024-nd-cp-quy-dinh-xu-phat-vi-pham-hanh-chinh-ve-trat-tu-atgt-duong-bo-119241231164556785.htm", "quote": "Điều 47 khoản 1–2: chủ phương tiện có mặt tại nơi xảy ra vi phạm thì lập biên bản và xử phạt; không có mặt thì lập biên bản đối với chủ phương tiện, người điều khiển ký với tư cách người chứng kiến", "verbatim": false, "checked": "2026-10-12"}], "content_type": "fine-lookup", "origin": "seed", "notes": "đã đối chiếu toàn văn Nghị định 168 và Luật 36/2024 ngày 12/10/2026", "suggested_internal_links": ["/luat-giao-thong/bao-nhieu-tuoi-duoc-di-xe-may/", "/luat-giao-thong/xe-50cc-co-can-bang-lai/", "/luat-giao-thong/khong-co-bang-lai-xe-may-phat-bao-nhieu/"], "outline": ["Câu trả lời ngắn", "Ai là “người không đủ điều kiện” theo Luật", "Mức phạt của chủ xe và của người lái", "Ba tình huống hay gặp: phụ huynh, bạn bè, cửa hàng", "Chủ xe không có mặt thì xử lý thế nào", "Kiểm tra gì trước khi giao chìa khóa", "Tra cứu và nộp phạt"]}
{"hub": "luat-giao-thong", "subtopic": "giay-to-bang-lai", "title": "Người nước ngoài lái xe máy ở Việt Nam: bằng lái quốc tế và mức phạt", "primary_keyword": "người nước ngoài lái xe máy ở việt nam", "secondary_keywords": ["bằng lái quốc tế có dùng được ở việt nam không", "giấy phép lái xe quốc tế idp việt nam"], "user_problem": "Du khách và người nước ngoài sống tại Việt Nam muốn biết giấy phép nào được lái xe máy hợp pháp, mang theo gì, không có thì bị phạt thế nào.", "information_gain": "Các bài /luat-giao-thong/bang-lai-xe-may-a1-a/, /luat-giao-thong/khong-co-bang-lai-xe-may-phat-bao-nhieu/ và /luat-giao-thong/quen-bang-lai-giay-to-xe-may-co-bi-phat-khong/ chỉ dành một mục ngắn cho người nước ngoài (mức phạt khi có bằng quốc tế nhưng không mang bằng quốc gia). Bài này là hướng dẫn trọn vẹn: những giấy phép có giá trị tại Việt Nam theo khoản 6 Điều 57 Luật 36/2024 (bằng quốc tế kèm bằng quốc gia của nước thành viên Công ước Viên 1968; bằng của nước có thỏa thuận công nhận lẫn nhau), bằng quốc tế có thời hạn không quá 3 năm và phải mang cả hai loại (khoản 8), thời gian tước bằng không quá thời gian được cư trú, mức phạt theo Điều 18 Nghị định 168 (2–4 triệu xe đến 125 cm³, 6–8 triệu xe lớn hơn), lựa chọn xe gắn máy dưới 50 cm³ và điều kiện thuê xe tại cửa hàng (cọc, hộ chiếu, tuổi).", "evidence": [{"type": "law", "source": "https://songoaivu.hatinh.gov.vn/imagess/seoworld/36-2024-qh15.pdf", "quote": "Điều 57 khoản 6: Giấy phép lái xe có giá trị sử dụng trong phạm vi lãnh thổ Việt Nam bao gồm: a) Giấy phép lái xe do cơ quan có thẩm quyền của Việt Nam cấp; b) Giấy phép lái xe quốc tế và giấy phép lái xe quốc gia phù hợp với loại xe được phép điều khiển do quốc gia là thành viên của Công ước của Liên hợp quốc về Giao thông đường bộ năm 1968 (sau đây gọi là Công ước Viên) cấp; c) Giấy phép lái xe phù hợp với loại xe được phép điều khiển của nước hoặc vùng lãnh thổ mà Việt Nam ký kết điều ước quốc tế hoặc thỏa thuận quốc tế công nhận giấy phép lái xe của nhau; d) Giấy phép lái xe nước ngoài phù hợp với loại xe được phép điều khiển do quốc gia được công nhận theo điều ước quốc tế mà nước Cộng hòa xã hội chủ nghĩa Việt Nam là thành viên.", "verbatim": true, "checked": "2026-10-12"}, {"type": "law", "source": "https://songoaivu.hatinh.gov.vn/imagess/seoworld/36-2024-qh15.pdf", "quote": "Điều 57 khoản 8: a) Giấy phép lái xe quốc tế là giấy phép lái xe do cơ quan nhà nước có thẩm quyền của quốc gia là thành viên của Công ước Viên cấp theo một mẫu thống nhất; có thời hạn không quá 03 năm kể từ ngày cấp và phải phù hợp với thời hạn còn hiệu lực của giấy phép lái xe quốc gia; b) Người có giấy phép lái xe quốc tế do quốc gia là thành viên của Công ước Viên cấp khi lái xe tham gia giao thông đường bộ trên lãnh thổ Việt Nam phải mang theo giấy phép lái xe quốc tế và giấy phép lái xe quốc gia được cấp phù hợp với hạng xe điều khiển, còn thời hạn sử dụng; phải tuân thủ pháp luật về trật tự, an toàn giao thông đường bộ của Việt Nam; c) Người có giấy phép lái xe quốc tế vi phạm pháp luật về trật tự, an toàn giao thông đường bộ của Việt Nam mà bị tước quyền sử dụng giấy phép lái xe có thời hạn thì thời gian bị tước quyền sử dụng không quá thời gian người lái xe được phép cư trú tại lãnh thổ Việt Nam", "verbatim": true, "checked": "2026-10-12"}, {"type": "law", "source": "https://xaydungchinhsach.chinhphu.vn/toan-van-nghi-dinh-168-2024-nd-cp-quy-dinh-xu-phat-vi-pham-hanh-chinh-ve-trat-tu-atgt-duong-bo-119241231164556785.htm", "quote": "Điều 18 khoản 5 (2.000.000–4.000.000 đồng, xe mô tô hai bánh đến 125 cm3 hoặc đến 11 kW): a) Không có giấy phép lái xe hoặc sử dụng giấy phép lái xe ... không phù hợp với loại xe đang điều khiển; b) Có giấy phép lái xe quốc tế do các nước tham gia Công ước của Liên hợp quốc về Giao thông đường bộ năm 1968 cấp (trừ giấy phép lái xe quốc tế do Việt Nam cấp) nhưng không mang theo giấy phép lái xe quốc gia phù hợp với loại xe được phép điều khiển; khoản 7 (6.000.000–8.000.000 đồng, xe trên 125 cm3 hoặc trên 11 kW): a) có giấy phép nhưng không phù hợp; b) không có giấy phép lái xe; c) có giấy phép quốc tế nhưng không mang theo giấy phép quốc gia", "verbatim": false, "checked": "2026-10-12"}, {"type": "business-facts", "source": "config/business-facts.json", "quote": "deposit: 2–5 triệu đồng tùy xe và thời hạn thuê; cọc tiền thì không giữ giấy tờ gốc", "checked": "2026-10-12"}, {"type": "business-facts", "source": "config/business-facts.json", "quote": "age: xe 50cc nhận khách từ 18 tuổi; xe khác khách từ 20 tuổi có giấy phép phù hợp", "checked": "2026-10-12"}, {"type": "business-facts", "source": "config/business-facts.json", "quote": "license_50cc: xe gắn máy dưới 50cc không yêu cầu bằng A1, người lái đủ 16 tuổi (theo chủ cửa hàng, 10/2026)", "checked": "2026-10-12"}], "content_type": "guide", "origin": "seed", "notes": "đã đối chiếu Luật 36/2024 (Điều 56, 57, 59) và Nghị định 168 (Điều 18) ngày 12/10/2026; danh sách nước thành viên Công ước Viên không liệt kê trong bài, hướng dẫn người đọc tự tra", "suggested_internal_links": ["/luat-giao-thong/bang-lai-xe-may-a1-a/", "/luat-giao-thong/khong-co-bang-lai-xe-may-phat-bao-nhieu/", "/thue-xe/thue-xe-may-ha-noi-can-giay-to-gi/", "/luat-giao-thong/xe-50cc-co-can-bang-lai/"], "outline": ["Câu trả lời ngắn", "Giấy phép nào được lái xe máy ở Việt Nam", "Bằng lái quốc tế: mang gì, hạn bao lâu", "Không có giấy phép hợp lệ bị phạt thế nào", "Bị tước bằng khi đang du lịch", "Không có bằng: chọn xe gắn máy dưới 50 cm³", "Thuê xe máy ở Hà Nội với hộ chiếu", "Kiểm tra lại văn bản gốc"]}
{"hub": "luat-giao-thong", "subtopic": "thu-tuc", "title": "Phạt nguội quá hạn không nộp bị gì? Thời hiệu xử phạt", "primary_keyword": "phạt nguội quá hạn không nộp", "secondary_keywords": ["không nộp phạt nguội có sao không", "thời hiệu xử phạt vi phạm giao thông"], "user_problem": "Chủ xe nhận thông báo muộn hoặc chưa nộp phạt; muốn biết tiền chậm nộp, cưỡng chế, cảnh báo đăng ký xe và thời hiệu.", "information_gain": "Bài /luat-giao-thong/tra-cuu-phat-nguoi-xe-may/ hướng dẫn tra cứu và quy trình gửi thông báo. Bài này trả lời riêng câu hỏi “quá hạn thì sao”: thời hạn 10 ngày chấp hành quyết định (Điều 73 Luật Xử lý vi phạm hành chính), tiền chậm nộp 0,05%/ngày và cưỡng chế bằng khấu trừ lương, tài khoản, kê biên tài sản (Điều 78, Điều 86); thời hiệu xử phạt 1 năm (Điều 6) và thời hiệu thi hành quyết định 1 năm (Điều 74) kèm cách tính khi cố tình trốn tránh; không đến giải quyết thì bị cảnh báo tới cơ quan đăng ký xe, cơ quan cấp giấy phép lái xe (khoản 11 Điều 47 Nghị định 168; khoản 5 Điều 24 Thông tư 73/2024/TT-BCA); xe thuê bị phạt nguội.", "evidence": [{"type": "law", "source": "https://datafiles.chinhphu.vn/cpp/files/vbpq/2026/10/171-vbhn-vpqh.signed.pdf", "quote": "Điều 73 khoản 1: Cá nhân, tổ chức bị xử phạt vi phạm hành chính phải chấp hành quyết định xử phạt trong thời hạn 10 ngày, kể từ ngày nhận quyết định xử phạt vi phạm hành chính; trường hợp quyết định xử phạt vi phạm hành chính có ghi thời hạn thi hành nhiều hơn 10 ngày thì thực hiện theo thời hạn đó.", "verbatim": true, "checked": "2026-10-12"}, {"type": "law", "source": "https://datafiles.chinhphu.vn/cpp/files/vbpq/2026/10/171-vbhn-vpqh.signed.pdf", "quote": "Điều 78 khoản 1: ... Nếu quá thời hạn nêu trên sẽ bị cưỡng chế thi hành quyết định xử phạt và cứ mỗi ngày chậm nộp tiền phạt thì cá nhân, tổ chức vi phạm phải nộp thêm 0,05% tính trên tổng số tiền phạt chưa nộp.", "verbatim": true, "checked": "2026-10-12"}, {"type": "law", "source": "https://datafiles.chinhphu.vn/cpp/files/vbpq/2026/10/171-vbhn-vpqh.signed.pdf", "quote": "Điều 74 khoản 1: Thời hiệu thi hành quyết định xử phạt vi phạm hành chính là 01 năm, kể từ ngày ra quyết định, quá thời hạn này thì không thi hành quyết định đó nữa, trừ trường hợp quyết định xử phạt có áp dụng hình thức xử phạt tịch thu tang vật, phương tiện vi phạm hành chính, biện pháp khắc phục hậu quả thì vẫn phải tịch thu tang vật, phương tiện, áp dụng biện pháp khắc phục hậu quả. Khoản 2: Trong trường hợp cá nhân, tổ chức bị xử phạt cố tình trốn tránh, trì hoãn thì thời hiệu nói trên được tính kể từ thời điểm chấm dứt hành vi trốn tránh, trì hoãn.", "verbatim": true, "checked": "2026-10-12"}, {"type": "law", "source": "https://datafiles.chinhphu.vn/cpp/files/vbpq/2026/10/171-vbhn-vpqh.signed.pdf", "quote": "Điều 6 khoản 1 điểm a: Thời hiệu xử phạt vi phạm hành chính là 01 năm, trừ các trường hợp sau đây (danh sách lĩnh vực 02 năm không có giao thông đường bộ); điểm b: đối với vi phạm đã kết thúc thì thời hiệu tính từ thời điểm chấm dứt hành vi vi phạm; điểm d: cố tình trốn tránh, cản trở việc xử phạt thì thời hiệu tính lại từ khi chấm dứt hành vi trốn tránh", "verbatim": false, "checked": "2026-10-12"}, {"type": "law", "source": "https://datafiles.chinhphu.vn/cpp/files/vbpq/2026/10/171-vbhn-vpqh.signed.pdf", "quote": "Điều 86 khoản 2: Các biện pháp cưỡng chế bao gồm: a) Khấu trừ một phần lương hoặc một phần thu nhập, khấu trừ tiền từ tài khoản của cá nhân, tổ chức vi phạm; b) Kê biên tài sản có giá trị tương ứng với số tiền phạt để bán đấu giá; c) Thu tiền, tài sản khác của đối tượng bị cưỡng chế ... do cá nhân, tổ chức khác đang giữ ...; d) Buộc thực hiện biện pháp khắc phục hậu quả", "verbatim": true, "checked": "2026-10-12"}, {"type": "law", "source": "https://xaydungchinhsach.chinhphu.vn/toan-van-nghi-dinh-168-2024-nd-cp-quy-dinh-xu-phat-vi-pham-hanh-chinh-ve-trat-tu-atgt-duong-bo-119241231164556785.htm", "quote": "Điều 47 khoản 11: Trường hợp quá thời hạn hẹn đến giải quyết vụ việc vi phạm được ghi trong biên bản vi phạm hành chính hoặc trong thông báo của người có thẩm quyền xử phạt hoặc quá thời hạn thi hành quyết định xử phạt mà chủ phương tiện vi phạm, người vi phạm chưa thực hiện giải quyết vụ việc vi phạm theo quy định hoặc chưa chấp hành quyết định xử phạt thì người có thẩm quyền xử phạt gửi thông báo cho cơ quan đăng kiểm (đối với phương tiện có quy định phải kiểm định), cơ quan đăng ký xe, cơ quan cấp giấy phép lái xe (nếu đã xác định được người vi phạm) ... b) Trường hợp khi tra cứu dữ liệu ... nếu có thông tin về phương tiện vi phạm, người vi phạm thì chưa giải quyết việc đăng kiểm, đăng ký xe, cấp, đổi, cấp lại giấy phép lái xe", "verbatim": true, "checked": "2026-10-12"}, {"type": "law", "source": "https://vanban.chinhphu.vn/?pageid=27160&docid=211864&classid=1", "quote": "Điều 24 khoản 5: Quá thời hạn 20 ngày, kể từ ngày gửi thông báo vi phạm, chủ phương tiện, tổ chức, cá nhân có liên quan đến vi phạm hành chính không đến trụ sở cơ quan Công an nơi phát hiện vi phạm để giải quyết vụ việc ... thì người có thẩm quyền xử phạt ... a) Gửi thông báo cảnh báo phương tiện giao thông vi phạm cho cơ quan Đăng kiểm (đối với phương tiện giao thông có quy định phải kiểm định), cơ quan đăng ký xe ...; b) Đối với phương tiện giao thông là xe mô tô, xe gắn máy, tiếp tục gửi thông báo đến Công an xã, phường, thị trấn nơi chủ phương tiện ... cư trú", "verbatim": true, "checked": "2026-10-12"}], "content_type": "procedure", "origin": "seed", "notes": "đã đối chiếu Luật Xử lý vi phạm hành chính (văn bản hợp nhất), Nghị định 168 Điều 47, Thông tư 73/2024 Điều 24 ngày 12/10/2026", "suggested_internal_links": ["/luat-giao-thong/tra-cuu-phat-nguoi-xe-may/", "/luat-giao-thong/nop-phat-vi-pham-giao-thong-online/", "/thue-xe/thue-xe-may-ha-noi-can-giay-to-gi/"], "outline": ["Câu trả lời ngắn", "Ba mốc thời gian cần phân biệt", "Quá 10 ngày không nộp: tiền chậm nộp và cưỡng chế", "Không đến giải quyết: cảnh báo đăng ký xe, cấp đổi giấy phép", "Thời hiệu 1 năm có “xóa” được phạt nguội không", "Nhận thông báo muộn hoặc không nhận được thì làm gì", "Xe thuê, xe mua lại bị phạt nguội", "Tra cứu và văn bản gốc"]}
{"hub": "luat-giao-thong", "subtopic": "thu-tuc", "title": "Bằng lái bị tạm giữ: khi nào được lấy lại, thủ tục", "primary_keyword": "bằng lái bị tạm giữ lấy lại thế nào", "secondary_keywords": ["csgt giữ bằng lái bao lâu", "bị giữ bằng lái có được lái xe không"], "user_problem": "Bị CSGT giữ giấy phép lái xe khi lập biên bản; muốn biết có được lái tiếp không, bao lâu lấy lại, cần làm gì.", "information_gain": "Chưa bài nào phân biệt TẠM GIỮ giấy phép lái xe (biện pháp bảo đảm thi hành quyết định, Điều 125 Luật Xử lý vi phạm hành chính) với TƯỚC quyền sử dụng (hình thức xử phạt, Điều 25). Bài này: vì sao chỉ phạt tiền mà vẫn bị giữ bằng (khoản 6 Điều 125), thời hạn tạm giữ 07 ngày làm việc, kéo dài tối đa 01–02 tháng (khoản 8), trong thời gian chờ ra quyết định vẫn được lái (khoản 7), quá hạn hẹn mà vẫn lái thì bị phạt như không có giấy tờ (khoản 2 Điều 48 Nghị định 168), thủ tục nhận lại bằng sau khi nộp phạt (trực tiếp hoặc online) và trường hợp bị tước thì chờ hết thời hạn.", "evidence": [{"type": "law", "source": "https://datafiles.chinhphu.vn/cpp/files/vbpq/2026/10/171-vbhn-vpqh.signed.pdf", "quote": "Điều 125 khoản 6: Trong trường hợp chỉ áp dụng hình thức phạt tiền đối với cá nhân, tổ chức vi phạm hành chính thì người có thẩm quyền xử phạt có quyền tạm giữ một trong các loại giấy tờ theo thứ tự: giấy phép lái xe hoặc giấy phép lưu hành phương tiện hoặc giấy tờ cần thiết khác có liên quan đến tang vật, phương tiện cho đến khi cá nhân, tổ chức đó chấp hành xong quyết định xử phạt.", "verbatim": true, "checked": "2026-10-12"}, {"type": "law", "source": "https://datafiles.chinhphu.vn/cpp/files/vbpq/2026/10/171-vbhn-vpqh.signed.pdf", "quote": "Điều 125 khoản 7: Cá nhân, tổ chức vi phạm hành chính thuộc trường hợp bị áp dụng hình thức xử phạt tước quyền sử dụng giấy phép, chứng chỉ hành nghề thì có thể bị tạm giữ giấy phép, chứng chỉ hành nghề để bảo đảm thi hành quyết định xử phạt. Việc tạm giữ giấy phép, chứng chỉ hành nghề trong thời gian chờ ra quyết định không làm ảnh hưởng quyền sử dụng giấy phép, chứng chỉ hành nghề của cá nhân, tổ chức đó.", "verbatim": true, "checked": "2026-10-12"}, {"type": "law", "source": "https://datafiles.chinhphu.vn/cpp/files/vbpq/2026/10/171-vbhn-vpqh.signed.pdf", "quote": "Điều 125 khoản 8: Thời hạn tạm giữ tang vật, phương tiện vi phạm hành chính, giấy phép, chứng chỉ hành nghề không quá 07 ngày làm việc, kể từ ngày tạm giữ; trường hợp vụ việc phải chuyển hồ sơ đến người có thẩm quyền xử phạt thì thời hạn tạm giữ không quá 10 ngày làm việc ... có thể được kéo dài ... nhưng không quá 01 tháng ... tiếp tục kéo dài nhưng không quá 02 tháng ... Trường hợp tạm giữ để bảo đảm thi hành quyết định xử phạt quy định tại điểm c khoản 1 Điều này thì thời hạn tạm giữ kết thúc khi quyết định xử phạt được thi hành xong.", "verbatim": true, "checked": "2026-10-12"}, {"type": "law", "source": "https://datafiles.chinhphu.vn/cpp/files/vbpq/2026/10/171-vbhn-vpqh.signed.pdf", "quote": "Điều 25 khoản 1: ... Trong thời gian bị tước quyền sử dụng giấy phép, chứng chỉ hành nghề, cá nhân, tổ chức không được tiến hành các hoạt động ghi trong giấy phép, chứng chỉ hành nghề. Khoản 3: Thời hạn tước quyền sử dụng giấy phép ... từ 01 tháng đến 24 tháng, kể từ ngày quyết định xử phạt có hiệu lực thi hành", "verbatim": true, "checked": "2026-10-12"}, {"type": "law", "source": "https://xaydungchinhsach.chinhphu.vn/toan-van-nghi-dinh-168-2024-nd-cp-quy-dinh-xu-phat-vi-pham-hanh-chinh-ve-trat-tu-atgt-duong-bo-119241231164556785.htm", "quote": "Điều 48 khoản 2: ... Khi bị tạm giữ giấy tờ theo quy định tại khoản 6 Điều 125 của Luật Xử lý vi phạm hành chính, nếu quá thời hạn hẹn đến giải quyết vụ việc vi phạm ghi trong biên bản vi phạm hành chính, người vi phạm chưa thực hiện giải quyết vụ việc vi phạm theo quy định mà vẫn tiếp tục điều khiển phương tiện hoặc đưa phương tiện ra tham gia giao thông thì bị áp dụng xử phạt như hành vi không có giấy tờ.", "verbatim": true, "checked": "2026-10-12"}], "content_type": "procedure", "origin": "seed", "notes": "đã đối chiếu Luật Xử lý vi phạm hành chính (Điều 25, 125) và Nghị định 168 (Điều 48) ngày 12/10/2026", "suggested_internal_links": ["/luat-giao-thong/nop-phat-vi-pham-giao-thong-online/", "/luat-giao-thong/tru-diem-bang-lai-xe-may/", "/luat-giao-thong/khong-co-bang-lai-xe-may-phat-bao-nhieu/", "/luat-giao-thong/cap-lai-bang-lai-xe-may-bi-mat/"], "outline": ["Câu trả lời ngắn", "Tạm giữ khác tước quyền sử dụng ở đâu", "Vì sao chỉ phạt tiền mà vẫn bị giữ bằng", "Bị giữ bằng có được lái xe tiếp không", "Thời hạn tạm giữ và ngày hẹn trên biên bản", "Thủ tục nhận lại bằng sau khi nộp phạt", "Bị tước bằng thì bao giờ được lấy lại", "Tra cứu và văn bản gốc"]}
{"hub": "luat-giao-thong", "subtopic": "muc-phat", "title": "Đua xe trái phép xe máy phạt bao nhiêu? Cổ vũ đua xe", "primary_keyword": "đua xe trái phép phạt bao nhiêu", "secondary_keywords": ["cổ vũ đua xe trái phép phạt bao nhiêu", "tổ chức đua xe trái phép phạt bao nhiêu"], "user_problem": "Người đi đường, phụ huynh và người trẻ muốn biết hậu quả pháp lý của đua xe, tụ tập cổ vũ, tổ chức đua xe.", "information_gain": "Chưa bài nào về Điều 35 Nghị định 168: người đua xe mô tô, xe gắn máy trái phép bị tịch thu phương tiện (khoản 3) và tước giấy phép lái xe 22–24 tháng với xe mô tô (khoản 4); tụ tập cổ vũ, giúp sức, xúi giục 1–2 triệu (khoản 1); tổ chức đua xe 40–50 triệu với cá nhân, 80–100 triệu với tổ chức (khoản 2). Bài phân biệt với các lỗi “gần đua xe” trong Điều 7: lạng lách, đánh võng (8–10 triệu, tước 10–12 tháng, tái phạm tịch thu xe), chạy quá tốc độ theo nhóm từ 2 xe, nẹt pô liên tục, bốc đầu (tịch thu xe) và lưu ý về trách nhiệm hình sự.", "evidence": [{"type": "law", "source": "https://xaydungchinhsach.chinhphu.vn/toan-van-nghi-dinh-168-2024-nd-cp-quy-dinh-xu-phat-vi-pham-hanh-chinh-ve-trat-tu-atgt-duong-bo-119241231164556785.htm", "quote": "Điều 35. 1. Phạt tiền từ 1.000.000 đồng đến 2.000.000 đồng đối với hành vi vi phạm tụ tập để cổ vũ, giúp sức, xúi giục hành vi điều khiển xe chạy quá tốc độ quy định, lạng lách, đánh võng, đuổi nhau trên đường hoặc đua xe trái phép. 2. Phạt tiền từ 40.000.000 đồng đến 50.000.000 đồng đối với cá nhân, từ 80.000.000 đồng đến 100.000.000 đồng đối với tổ chức thực hiện hành vi vi phạm tổ chức đua xe trái phép. 3. Tịch thu phương tiện đối với người điều khiển phương tiện thực hiện một trong các hành vi vi phạm sau đây: a) Đua xe gắn máy, xe đạp máy, xe đạp trái phép trên đường giao thông; b) Đua xe ô tô, mô tô trái phép trên đường giao thông. 4. Ngoài việc bị tịch thu phương tiện, người điều khiển phương tiện thực hiện hành vi quy định tại điểm b khoản 3 Điều này bị áp dụng hình thức xử phạt bổ sung tước quyền sử dụng giấy phép lái xe từ 22 tháng đến 24 tháng.", "verbatim": true, "checked": "2026-10-12"}, {"type": "law", "source": "https://xaydungchinhsach.chinhphu.vn/toan-van-nghi-dinh-168-2024-nd-cp-quy-dinh-xu-phat-vi-pham-hanh-chinh-ve-trat-tu-atgt-duong-bo-119241231164556785.htm", "quote": "Điều 7 khoản 9 (8.000.000–10.000.000 đồng): a) lạng lách, đánh võng; dùng chân chống hoặc vật khác quệt xuống đường khi xe đang chạy; b) điều khiển xe thành nhóm từ 02 xe trở lên chạy quá tốc độ quy định; k) bấm còi, rú ga (nẹt pô) liên tục trong khu đông dân cư, khu vực cơ sở khám bệnh, chữa bệnh; khoản 11: tịch thu phương tiện với b) chạy bằng một bánh đối với xe hai bánh, c) tái phạm lạng lách, đánh võng; khoản 12 điểm b: tước giấy phép lái xe 10–12 tháng với 9a, 9b, 9k", "verbatim": false, "checked": "2026-10-12", "note": "scratchpad/nd168/dieu7-notes.md"}], "content_type": "fine-lookup", "origin": "seed", "notes": "đã đối chiếu toàn văn Nghị định 168 (Điều 7, Điều 35) ngày 12/10/2026; không nêu khung hình phạt hình sự vì chưa đối chiếu Bộ luật Hình sự", "suggested_internal_links": ["/luat-giao-thong/xe-may-chay-qua-toc-do-phat-bao-nhieu/", "/luat-giao-thong/tru-diem-bang-lai-xe-may/", "/luat-giao-thong/bao-nhieu-tuoi-duoc-di-xe-may/"], "outline": ["Câu trả lời ngắn", "Bảng mức phạt theo Điều 35", "Lạng lách, đánh võng, chạy theo nhóm: lỗi khác đua xe", "Đứng xem và cổ vũ cũng bị phạt", "Xe bị tịch thu: của mình hay xe mượn, xe thuê", "Trách nhiệm hình sự khi nào", "Tra cứu và nộp phạt"]}
{"hub": "bao-duong", "subtopic": "bo-phan", "title": "Nước làm mát xe máy bao lâu thay? Xe nào có két nước", "primary_keyword": "nước làm mát xe máy bao lâu thay", "secondary_keywords": ["xe máy nào làm mát bằng dung dịch", "châm nước làm mát xe máy"], "user_problem": "Không biết xe mình có két nước không, khi nào kiểm tra, khi nào thay, châm gì.", "information_gain": "Cùng dạng câu hỏi \"bao lâu thay\" nhưng khác bộ phận, mốc thay và dấu hiệu: ắc quy /bao-duong/binh-ac-quy-xe-may-bao-lau-thay/, lốp /bao-duong/lop-xe-may-bao-lau-thay/, dây curoa /bao-duong/day-curoa-xe-ga-bao-lau-thay/, nước làm mát /bao-duong/nuoc-lam-mat-xe-may-bao-lau-thay/, lọc gió /bao-duong/thay-loc-gio-xe-may-bao-lau-mot-lan/. Mỗi bài trả lời một bộ phận theo sổ tay nhà sản xuất; không gộp thành bài chung chung. Số liệu lấy từ nguồn chính thức: hỏi đáp Honda Việt Nam (kiểm tra định kỳ mỗi 15.000 km hoặc 12 tháng, thay mới sau 30.000 km hoặc 36 tháng; không pha phụ gia; giữ mực giữa vạch Upper và Lower) và bảng bảo dưỡng trong sách hướng dẫn sử dụng Air Blade 125/160, Lead 125, Winner R (thay dung dịch làm mát két tản nhiệt sau 3 năm); phân biệt xe làm mát bằng dung dịch với xe làm mát bằng không khí (Vision, Wave Alpha).", "evidence": [{"type": "manufacturer", "source": "https://www.honda.com.vn/cau-hoi-thuong-gap", "quote": "Dung dịch làm mát nên được kiểm tra định kỳ sau mỗi 15.000km hoặc 12 tháng và thay mới sau 30.000km hoặc 36 tháng.", "verbatim": true, "checked": "2026-10-12"}, {"type": "manufacturer", "source": "https://www.honda.com.vn/cau-hoi-thuong-gap", "quote": "Với dung dịch làm mát được Honda cung cấp ra thị trường đã được pha chế đảm bảo phục vụ cho động cơ hoạt động ở tình trạng tốt nhất. Do đó chúng tôi khuyến cáo khách hàng sử dụng đúng dung dịch làm mát này cho xe Honda mà không pha chế thêm vào dung dịch làm mát.", "verbatim": true, "checked": "2026-10-12"}, {"type": "manufacturer", "source": "https://www.honda.com.vn/cau-hoi-thuong-gap", "quote": "Trong quá trình sử dụng thì cần duy trì mực nước làm mát luôn nằm trong phạm vi vạch Upper và Lower. Mỗi khi thay thế nước làm mát, cần đổ nước làm mát đến mực Upper để đảm bảo nước làm mát không thiếu hụt khi động cơ nóng lên. Không đổ nước làm mát cao hơn vạch Upper ... Nếu mực nước mát dưới vạch Lower, không khí có thể lọt vào đường ống nước tạo ra bọt khí bên trong đường ống, làm giảm hiệu quả làm mát, trường hợp xấu có thể gây quá nhiệt động cơ.", "verbatim": true, "checked": "2026-10-12"}, {"type": "manufacturer", "source": "https://cdn.honda.com.vn/motorbike-manual/November2025/yGA1ooMcYBDaX4NEkfnH.pdf", "quote": "Bảng bảo dưỡng định kỳ Air Blade 125/160 (ACA125/ACA160): Dung dịch làm mát két tản nhiệt – thay 3 năm; Dầu truyền động cuối – 2 năm", "verbatim": false, "checked": "2026-10-12"}, {"type": "manufacturer", "source": "https://cdn.honda.com.vn/motorbike-manual/November2025/a1ImE0kmkoA3Vj3r5eVr.pdf", "quote": "Bảng bảo dưỡng định kỳ LEAD 125: Dung dịch làm mát két tản nhiệt – 3 năm", "verbatim": false, "checked": "2026-10-12"}, {"type": "manufacturer", "source": "https://cdn.honda.com.vn/motorbike-manual/September2025/im0nZUX5oUFckKyXnVNi.pdf", "quote": "Bảng bảo dưỡng định kỳ Winner R: Dung dịch làm mát két tản nhiệt – 3 năm", "verbatim": false, "checked": "2026-10-12"}, {"type": "manufacturer", "source": "https://www.honda.com.vn/xe-may/san-pham/vision", "quote": "Trang sản phẩm Honda Vision: loại động cơ xăng, 4 kỳ, 1 xi lanh, làm mát bằng không khí (đối chiếu 12/10/2026)", "verbatim": false, "checked": "2026-10-12"}], "content_type": "guide", "origin": "seed", "notes": "nguồn chính thức Honda Việt Nam đã đối chiếu 12/10/2026", "suggested_internal_links": ["/bao-duong/xe-may-moi-mua-bao-duong-lan-dau-khi-nao/", "/bao-duong/xe-may/thay-nhot/", "/bao-duong/xe-may-ngap-nuoc-phai-lam-sao/"], "outline": ["Câu trả lời ngắn", "Xe nào có két nước, xe nào làm mát bằng gió", "Mốc kiểm tra và thay theo Honda", "Cách kiểm tra mực nước làm mát tại nhà", "Châm gì, không châm gì", "Dấu hiệu hệ thống làm mát có vấn đề", "Chi phí và nơi làm"]}
{"hub": "bao-duong", "subtopic": "su-co", "title": "Xe máy ngập nước phải làm sao? Các bước trước khi nổ máy lại", "primary_keyword": "xe máy ngập nước phải làm sao", "secondary_keywords": ["xe máy bị ngập nước chết máy", "xe máy đi qua đường ngập cần kiểm tra gì"], "user_problem": "Xe chết máy giữa đoạn ngập hoặc vừa đi qua nước sâu; cần biết việc nào làm ngay, việc nào tuyệt đối không làm.", "information_gain": "Bài /thue-xe/xe-may-thue-bi-hong-giua-duong-phai-lam-sao/ nói về trách nhiệm chi phí với xe thuê; bài này là quy trình kỹ thuật theo hỏi đáp chính thức của Honda Việt Nam: không cố khởi động lại khi chết máy do ngập (nguy cơ cong tay biên), tắt khóa điện, dựng chân chống chính, tháo bugi, đạp cần khởi động cho nước thoát, lau khô bugi và nắp chụp, kiểm tra que thăm dầu, thay dầu nếu dầu đổi màu, kiểm tra cả dầu truyền động cuối với xe ga, bảo dưỡng dày hơn trong mùa mưa; thêm phần đi qua đoạn ngập an toàn ở Hà Nội.", "evidence": [{"type": "manufacturer", "source": "https://www.honda.com.vn/cau-hoi-thuong-gap", "quote": "Khi xe bị chết máy do bị ngập nước, Quý khách không nên cố khởi động lại vì có thể nước đã lọt vào xy lanh và việc cố khởi động động cơ có thể dẫn tới bị cong tay biên. Trước tiên, Quý khách hãy đưa xe ra khỏi khu vực ngập nước rồi tắt khóa điện, và dựng xe trên chân chống chính và tháo bugi ra. Tiếp theo, Quý khách đạp cần khởi động vài lần để nước thoát hết ra khỏi xi lanh, lau khô bugi và nắp chụp, sau đó mới lắp bugi vào để đạp nổ... Đồng thời, Quý khách nên tháo que thăm dầu ra kiểm tra xem dầu có bị nước vào không. Nếu có nước vào thì tốt nhất Quý khách nên thay dầu máy trước khi khởi động xe.", "verbatim": true, "checked": "2026-10-12"}, {"type": "manufacturer", "source": "https://www.honda.com.vn/cau-hoi-thuong-gap", "quote": "Nếu xe không chết máy thì khi về đến nhà Quý khách cần kiểm tra dầu máy ngay. Nếu dầu bị biến màu (màu của dầu biến màu tùy mức độ nước vào từ vàng nhờ sang trắng sữa) thì phải súc rửa động cơ và thay dầu máy mới. Nếu dầu không biến màu thì 1 – 2 ngày sau cũng cần kiểm tra lại. Bên cạnh đó, với xe tay ga, ngoài việc kiểm tra dầu máy, Quý khách nên lưu ý kiểm tra thêm cả dầu truyền động cuối để đảm bảo bộ phận truyền động của xe cũng hoạt động tốt.", "verbatim": true, "checked": "2026-10-12"}, {"type": "manufacturer", "source": "https://www.honda.com.vn/cau-hoi-thuong-gap", "quote": "Nên kiểm tra và bảo dưỡng thường xuyên hơn lịch trình tiêu chuẩn khi xe chạy trong mùa mưa (quy định trong cuốn hướng dẫn sử dùng kèm theo xe của Honda Việt Nam). Các thao tác kiểm tra, bảo dưỡng, thay thế nên được thực hiện tại các cửa hàng Honda ủy nhiệm (HEAD) trừ khi Quý khách có tay nghề cơ khí, dụng cụ hợp lý và hướng dẫn kỹ thuật của Honda Việt Nam.", "verbatim": true, "checked": "2026-10-12"}, {"type": "manufacturer", "source": "https://www.honda.com.vn/cau-hoi-thuong-gap", "quote": "Ngoài ra nếu Quý khách đi vào đoạn đường ngập nước thì nên đưa xe đến cửa hàng Honda ủy nhiệm (HEAD) để kiểm tra xem có bị nước vào hay không để thay thế kịp thời.", "verbatim": true, "checked": "2026-10-12"}], "content_type": "guide", "origin": "seed", "notes": "nguồn chính thức Honda Việt Nam (mục mùa mưa, dầu láp) đã đối chiếu 12/10/2026", "suggested_internal_links": ["/thue-xe/xe-may-thue-bi-hong-giua-duong-phai-lam-sao/", "/bao-duong/xe-may/thay-nhot/", "/bao-duong/xe-may-de-lau-khong-di/"], "outline": ["Câu trả lời ngắn", "Việc tuyệt đối không làm: cố đề lại", "Các bước xử lý tại chỗ theo Honda", "Về nhà kiểm tra gì trong 1–2 ngày", "Xe ga: kiểm tra cả dầu láp", "Đi qua đoạn ngập thế nào để bớt rủi ro", "Xe thuê bị ngập nước"]}
{"hub": "bao-duong", "subtopic": "su-co", "title": "Xe máy để lâu không đi: cách bảo quản và khởi động lại", "primary_keyword": "xe máy để lâu không đi", "secondary_keywords": ["bảo quản xe máy khi không sử dụng lâu ngày", "xe máy lâu không đi không nổ máy"], "user_problem": "Đi công tác, về quê, du học nhiều tuần; xe để nhà không nổ, ắc quy hết điện, lốp xẹp.", "information_gain": "Chưa bài nào về bảo quản xe không dùng nhiều tuần. Nội dung theo hỏi đáp chính thức của Honda Việt Nam: 5 việc cần làm (rửa sạch, dựng chân chống đứng, bôi trơn xích, tháo cực âm ắc quy hoặc nổ máy mỗi tuần 10 phút, phủ bạt nếu để ngoài trời), vì sao ắc quy tự hết điện kể cả khi tắt khóa (đồng hồ, chống trộm, Smart Key), không nổ máy tại chỗ quá lâu với xe làm mát bằng không khí; thêm checklist khởi động lại sau thời gian dài và khi nào nên mang ra HEAD.", "evidence": [{"type": "manufacturer", "source": "https://www.honda.com.vn/cau-hoi-thuong-gap", "quote": "Trong trường hợp xe của Quý khách để lâu ngày không sử dụng, Quý khách nên bảo quản xe như sau: - Rửa xe sạch sẽ - Dựng xe bằng chân chống đứng - Bôi trơn xích tải (nếu có) - Tránh hết điện bình ắc quy: Quý Khách nên tháo dây cực âm ra khỏi bình ắc quy để tránh hiện tượng phóng điện gây hao hụt điện áp, hoặc nổ máy mỗi tuần một lần trong khoảng 10 phút để sạc điện cho bình. - Phủ bạt lên toàn bộ xe nếu Quý khách bảo quản xe ở ngoài trời. Lưu ý: + Quý khách nên để HEAD thực hiện việc tháo dây cực âm ra khỏi bình ắc quy nếu không có đủ dụng cụ và kỹ năng cơ khí cần thiết. + Quý khách không nên nổ máy tại chỗ quá lâu, đặc biệt các xe làm mát bằng không khí, sẽ có nguy cơ bị quá nhiệt gây hư hỏng động cơ.", "verbatim": true, "checked": "2026-10-12"}, {"type": "manufacturer", "source": "https://www.honda.com.vn/cau-hoi-thuong-gap", "quote": "Bình điện sẽ vẫn tiêu hao điện ngay cả khi không sử dụng, dù lắp trên xe hay để riêng bên ngoài, đặc biệt trong điều kiện môi trường độ ẩm và nhiệt độ cao. Nếu xe của Quý khách có gắn các thiết bị như Đồng hồ báo giờ, cảnh báo chống trộm, Hệ thống SMART Key,... thì ngoài việc tự tiêu hao điện thông thường khi không sử dụng, bình điện còn tiêu thụ một lượng điện trong bình để cung cấp dòng điện duy trì hoạt động các hệ thống này ngay cả khi đã tắt khóa điện. Khi bình điện không được sạc trong một thời gian dài, lượng điện trong bình sẽ tiêu hao dần ..., nếu lượng điện giảm quá mức, các thiết bị điện trên xe có thể không được cung cấp đủ năng lượng để hoạt động, bình điện có thể bị hỏng và không thể sạc lại.", "verbatim": true, "checked": "2026-10-12"}], "content_type": "troubleshooting", "origin": "seed", "notes": "nguồn chính thức Honda Việt Nam (bảo quản xe, ắc quy) đã đối chiếu 12/10/2026", "suggested_internal_links": ["/bao-duong/xe-may/ap-suat-lop/", "/bao-duong/xe-may/thay-nhot/", "/bao-duong/rua-xe-may-tai-nha-dung-cach/", "/thue-xe-may/ha-noi/theo-thang/"], "outline": ["Câu trả lời ngắn", "Trước khi cất xe: 5 việc theo Honda", "Vì sao ắc quy hết điện dù không dùng xe", "Nổ máy mỗi tuần hay tháo cực âm", "Khởi động lại sau nhiều tuần: kiểm tra theo thứ tự", "Khi nào nên mang ra tiệm", "Đi xa dài ngày: thuê xe thay vì để xe nhà"]}
{"hub": "bao-duong", "subtopic": "cham-soc", "title": "Rửa xe máy tại nhà đúng cách: tránh hỏng điện, hỏng sơn", "primary_keyword": "rửa xe máy tại nhà", "secondary_keywords": ["rửa xe máy bằng vòi xịt áp lực có hại không", "cách rửa xe máy không hỏng sơn"], "user_problem": "Muốn tự rửa xe tiết kiệm nhưng sợ nước vào điện, vào pô, hỏng sơn; không biết dùng gì, tránh gì.", "information_gain": "Chưa bài nào hướng dẫn rửa xe. Nội dung theo khuyến cáo chính thức của Honda Việt Nam: rửa qua bằng nước lạnh rồi dùng xốp hoặc vải mềm với chất tẩy nhẹ, không dùng hóa chất không dành cho xe, chờ máy và ống xả nguội, không rửa bằng vòi phun cao áp (hỏng bộ phận điện tử và bộ phận chuyển động), tránh nước vào ống bô, kiểm tra lại phanh sau khi rửa, đèn trước có thể mờ hơi nước; thêm trình tự rửa 20 phút tại nhà, dụng cụ cần có và tần suất.", "evidence": [{"type": "manufacturer", "source": "https://www.honda.com.vn/cau-hoi-thuong-gap", "quote": "Việc thường xuyên lau rửa xe sẽ giúp Quý khách kiểm tra xe có bị hư hỏng không và phát hiện kịp thời sự cố rò rỉ dầu máy, dầu phanh, bảo vệ bề mặt xe sáng bóng. Khi rửa xe, Quý khách nên dùng nước lạnh để rửa qua trước, nhằm loại bỏ các chất bám bẩn, sau đó dùng miếng xốp hoặc vải mềm cùng với dung dịch có chất tẩy rửa nhẹ.", "verbatim": true, "checked": "2026-10-12"}, {"type": "manufacturer", "source": "https://www.honda.com.vn/cau-hoi-thuong-gap", "quote": "Quý khách tránh rửa bằng các hóa chất không được thiết kế để sử dụng cho việc lau rửa các bề mặt của xe máy hoặc xe ô tô vì các hóa chất đó có thể chứa các chất có tính tẩy rửa hoặc dung môi làm hỏng các chi tiết bằng kim loại, sơn và nhựa của xe. Nếu xe vẫn còn nóng thì Quý khách nên đợi cho máy và hệ thống khí xả nguội rồi mới rửa xe. Lưu ý không nên rửa xe bằng vòi phun cao áp vì có thể làm hư các bộ phận điện tử và các bộ phận chuyển động. Đặc biệt tránh để nước vào trong ống bô vì nếu nước đọng lại bên trong ống bô, ống bô sẽ bị rỉ sét hoặc động cơ khó khởi động.", "verbatim": true, "checked": "2026-10-12"}, {"type": "manufacturer", "source": "https://www.honda.com.vn/cau-hoi-thuong-gap", "quote": "Ngàm phanh và đĩa phanh có thể kém hiệu quả khi bị ướt nên phải kiểm tra lại phanh tại nơi an toàn sau khi rửa xe. Ngay sau khi rửa xe, có thể xuất hiện đám sương trong bóng đèn trước vì vậy Quý khách nên để đèn trước sáng khi điều khiển.", "verbatim": true, "checked": "2026-10-12"}], "content_type": "guide", "origin": "seed", "notes": "nguồn chính thức Honda Việt Nam (mục rửa xe) đã đối chiếu 12/10/2026", "suggested_internal_links": ["/bao-duong/xe-may-de-lau-khong-di/", "/kinh-nghiem/cach-phanh-xe-may-an-toan/", "/bao-duong/xe-may/ap-suat-lop/"], "outline": ["Câu trả lời ngắn", "Chuẩn bị: dụng cụ và chỗ rửa", "Trình tự rửa theo khuyến cáo của Honda", "Những chỗ không được xịt thẳng nước", "Vòi xịt áp lực: vì sao Honda khuyên không dùng", "Sau khi rửa: lau khô, thử phanh, đèn mờ hơi nước", "Bao lâu rửa một lần"]}
